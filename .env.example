# Copy this file to .env and paste your real keys in.
#   Copy-Item .env.example .env
#
# .env is git-ignored. This template is committed so anyone cloning the repo
# knows which keys the project needs.

# Primary provider. Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Fallback provider, used automatically when Groq returns a rate limit (429)
# or a server error (5xx). Free tier: https://cloud.cerebras.ai
# The pipeline makes 4-6 LLM calls per question, so an evaluation run is a
# burst of ~50 calls - exactly where a free tier throttles.
CEREBRAS_API_KEY=
